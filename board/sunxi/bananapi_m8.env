bootdelay=3
verbosity=1
bootlogo=false
console=both
earlycon=off
load_addr=0x47000000
scriptaddr=0x4fc00000
kernel_addr_r=0x40080000
fdt_addr_r=0x46000000
ramdisk_addr_r=0x43000000
fdt_high=0xffffffffffffffff
initrd_high=0xffffffffffffffff
fdtfile=sunxi/sun60i-a733-bananapi-m8.dtb
overlay_prefix=sun60i-a733
armbian_boot=1
rootfstype=ext4
usbstoragequirks=
extraargs=
extraboardargs=
partuuid=
rootdev=
bootcmd=for bootdev in 0 2; do if mmc dev ${bootdev}; then if mmc rescan; then if fatload mmc ${bootdev}:1 ${scriptaddr} boot.scr; then setenv devtype mmc; setenv devnum ${bootdev}; setenv bootpart 1; setenv rootpart 2; setenv prefix /; source ${scriptaddr}; fi; if ext4load mmc ${bootdev}:1 ${scriptaddr} /boot/boot.scr; then setenv devtype mmc; setenv devnum ${bootdev}; setenv bootpart 1; setenv rootpart 1; setenv prefix /boot/; source ${scriptaddr}; fi; fi; fi; done; echo ERROR: SD/eMMC boot scripts did not start a kernel. Check boot.scr and image files.
